# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Supabase (optional — session persistence). Leave blank to disable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# CORS
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# Microsoft Entra External ID (customer tenant) — used to VERIFY the
# Bearer access token that the frontend sends. Leave blank in dev to
# accept anonymous requests.
# ------------------------------------------------------------------
# Your customer tenant subdomain (the part before .ciamlogin.com).
# Example: if tenant is contoso.ciamlogin.com  ->  contoso
ENTRA_TENANT_SUBDOMAIN=LearnerPath.onmicrosoft.com
# Tenant GUID (Entra portal -> Overview -> "Tenant ID")
ENTRA_TENANT_ID=107b7282-a4c9-4608-b9a6-c44cd62f8edc
# Client ID of the backend/API app registration (Application (client) ID).
# This is the "audience" (aud) claim required in tokens.
ENTRA_API_CLIENT_ID=
# Optional: require a specific scope (scp) in the token, e.g. "LearnPath.Access"
ENTRA_REQUIRED_SCOPE=
# Dev only: set to true to disable auth locally
ENTRA_AUTH_DISABLED=false
SPA_CLIENT_ID=0ca259fd-bdf4-44f9-bf5d-eca7de4f96cd